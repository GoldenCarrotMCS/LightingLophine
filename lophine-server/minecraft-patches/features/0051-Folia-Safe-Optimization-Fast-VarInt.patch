From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: FoliaOptimizer <optimizer@example.com>
Date: Tue, 24 Oct 2023 10:00:00 +0000
Subject: [PATCH] Folia Safe Optimization: Fast VarInt Encoding

Unrolls the loop for 1-byte and 2-byte VarInt encodings/decodings which form
over 90% of Minecraft network traffic. Reduces branch mispredictions.

diff --git a/net/minecraft/network/FriendlyByteBuf.java b/net/minecraft/network/FriendlyByteBuf.java
index 1111111111111111111111111111111111111111..2222222222222222222222222222222222222222 100644
--- a/net/minecraft/network/FriendlyByteBuf.java
+++ b/net/minecraft/network/FriendlyByteBuf.java
@@ -10,6 +10,18 @@ public class FriendlyByteBuf extends ByteBuf {
 
     public FriendlyByteBuf writeVarInt(int value) {
+        // Lophine start - Folia Safe Optimization: Fast VarInt Encoding
+        if (fun.bm.lophine.config.modules.experiment.FoliaOptimizationConfig.fastVarint) {
+            if ((value & (0xFFFFFFFF << 7)) == 0) {
+                this.writeByte(value);
+                return this;
+            } else if ((value & (0xFFFFFFFF << 14)) == 0) {
+                this.writeShort((value & 0x7F | 0x80) << 8 | (value >>> 7));
+                return this;
+            }
+        }
+        // Lophine end
         while ((value & -128) != 0) {
             this.writeByte(value & 127 | 128);
             value >>>= 7;
         }
         this.writeByte(value);
         return this;
     }
 }
